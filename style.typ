#let page_parms = (
  paper: "a4",
  // width:auto, height:auto,
  // flipped:false,
  margin: (x: 3.18cm, y: 2.54cm), // todo: calib
  // bleed: (:) // margin out of the page
  // binding: auto // bound page with text direction
  // columns: 1,
  // fill: auto, // color
