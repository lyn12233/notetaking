)

#let basic_text_parms = (
  font: font_parms._font.SongTi,
  fallback: false, // unknown glyph without fallback cause panic
  // style: "normal",
  weight: "regular", // heading will try to change this implicitly
  // stretch: 100%,
  size: font_parms.size.XiaoSi,
  // fill: luma(0),
